1 VERSIONINFO
 FILEVERSION @MAJOR@,@MINOR@,@PATCH@,0
 PRODUCTVERSION @MAJOR@,@MINOR@,@PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x00040004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Marc Fargas\0"
            VALUE "FileDescription", "go-mapi resident service\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "ProductName", "go-mapi resident service\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Thin system-SKU product entry. Reusable machine resources live in
       SharedMachine.wxs so the suite can consume byte-identical components. -->
  <Package Name="go-mapi system component" Manufacturer="go-mapi"
    Version="$(var.MsiProductVersion)" UpgradeCode="$(var.UpgradeCode)"
    ProductCode="$(var.ProductCode)" Scope="perMachine"
    InstallerVersion="500" Compressed="yes">
    <SummaryInformation Description="go-mapi machine-wide interceptor and resident update service" />
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer go-mapi system component is already installed."
      AllowSameVersionUpgrades="yes" />
    <Upgrade Id="$(var.ForeignUpgradeCode)">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes"
        Property="GOMAPI_FOREIGN_PRODUCT" />
    </Upgrade>
    <Launch Condition="VersionNT64" Message="go-mapi system component requires 64-bit Windows." />
    <Launch Condition="Installed OR NOT GOMAPI_FOREIGN_PRODUCT OR GOMAPI_MIGRATE_SKU = &quot;1&quot;"
      Message="Another go-mapi machine package is installed. An administrator must explicitly authorize SKU migration." />
    <Property Id="GOMAPI_TEST_FAILURE_POINT" Secure="yes" />
    <Property Id="GOMAPI_MIGRATE_SKU" Secure="yes" />
    <Property Id="GOMAPI_COMPONENT_VERSION" Value="$(var.InterceptorVersion)" Secure="yes" />
    <Property Id="GOMAPI_REQUIRED_APP_MIN" Value="$(var.RequiredAppMin)" Secure="yes" />

    <Feature Id="SystemProduct" Title="go-mapi system component" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="InterceptorComponents" />
      <ComponentGroupRef Id="ResidentServiceComponents" />
      <ComponentGroupRef Id="SystemHealthComponents" />
    </Feature>

    <CustomActionRef Id="PrepareAdminMigration" />
    <CustomActionRef Id="RollbackAdminMigration" />
    <CustomActionRef Id="RollbackServiceConfiguration" />
    <CustomActionRef Id="ApplyAdminMigration" />
    <CustomActionRef Id="VerifyAdminRegistration" />
    <CustomActionRef Id="PrepareAdminUninstall" />
    <CustomActionRef Id="RollbackAdminUninstall" />
    <CustomActionRef Id="FinalizeAdminUninstall" />
    <InstallExecuteSequence>
      <FindRelatedProducts Before="LaunchConditions" />
      <Custom Action="RollbackServiceConfiguration" Before="DeleteServices" Condition="REMOVE~=&quot;ALL&quot; AND UPGRADINGPRODUCTCODE" />
      <Custom Action="PrepareAdminMigration" Before="RollbackAdminMigration" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="RollbackAdminMigration" Before="ApplyAdminMigration" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="ApplyAdminMigration" After="RemoveExistingProducts" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="VerifyAdminRegistration" After="WriteRegistryValues" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="PrepareAdminUninstall" Before="RollbackAdminUninstall" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackAdminUninstall" Before="FinalizeAdminUninstall" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="FinalizeAdminUninstall" After="RemoveRegistryValues" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>

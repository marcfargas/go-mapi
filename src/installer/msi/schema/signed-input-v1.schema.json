{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-mapi.invalid/schema/machine-signed-input-v1.json",
  "title": "go-mapi machine signed build inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sku", "packageRelease", "commit", "components"],
  "properties": {
    "schema": { "const": "go-mapi-machine-signed-input-v1" },
    "sku": { "const": "system" },
    "packageRelease": { "type": "string" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "components": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component", "version", "artifacts"],
        "properties": {
          "component": { "enum": ["service", "interceptor"] },
          "version": { "type": "string" },
          "artifacts": {
            "type": "array", "minItems": 1, "maxItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["architecture", "filename", "sha256"],
              "properties": {
                "architecture": { "enum": ["x86", "x64"] },
                "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}

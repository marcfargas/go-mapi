#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @GO_MAPI_VERSION_MAJOR@,@GO_MAPI_VERSION_MINOR@,@GO_MAPI_VERSION_PATCH@,0
 PRODUCTVERSION @GO_MAPI_VERSION_MAJOR@,@GO_MAPI_VERSION_MINOR@,@GO_MAPI_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Marc Fargas\0"
            VALUE "FileDescription", "go-mapi interceptor\0"
            VALUE "FileVersion", "@GO_MAPI_VERSION@\0"
            VALUE "ProductName", "go-mapi interceptor\0"
            VALUE "ProductVersion", "@GO_MAPI_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

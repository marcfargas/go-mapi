{
  "name": "go-mapi",
  "description": "MAPI to Gmail bridge for Windows - send emails via Gmail from any Windows application",
  "private": true,
  "workspaces": [
    "src/extension",
    "src/native-host",
    "src/app"
  ],
  "scripts": {
    "build": "npm run build:interceptor && npm run build:native-host && npm run build:extension",
    "build:interceptor": "powershell -ExecutionPolicy Bypass -File src/interceptor/build.ps1 -Config Release",
    "build:interceptor:debug": "powershell -ExecutionPolicy Bypass -File src/interceptor/build.ps1 -Config Debug -Tests",
    "build:native-host": "powershell -ExecutionPolicy Bypass -Command \"$v=(Get-Content src/native-host/package.json -Raw|ConvertFrom-Json).version; cd src/native-host; go build -ldflags \\\"-s -w -X main.Version=$v\\\" -o build/go-mapi-host.exe .\"",
    "build:native-host:debug": "powershell -ExecutionPolicy Bypass -Command \"$v=(Get-Content src/native-host/package.json -Raw|ConvertFrom-Json).version; cd src/native-host; go build -ldflags \\\"-X main.Version=$v\\\" -o build/go-mapi-host.exe .\"",
    "build:extension": "npm run -w go-mapi-extension build",
    "package:extension": "powershell -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "dev:extension": "npm run -w go-mapi-extension dev",
    "lint": "eslint src/extension/src/ && cd src/native-host && go vet ./...",
    "test": "npm run test:native-host && npm run test:extension",
    "test:native-host": "cd src/native-host && go test -v ./...",
    "test:extension": "npm run -w go-mapi-extension test:run",
    "test:interceptor": "powershell -ExecutionPolicy Bypass -Command \"src/interceptor/build/bin/go-mapi-test-harness.exe src/interceptor/build/bin/go-mapi.dll\"",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.config.ts",
    "test:coverage": "npm run -w go-mapi-extension test:coverage",
    "clean": "npm run clean:interceptor && npm run clean:native-host && npm run clean:extension",
    "clean:interceptor": "powershell -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force src/interceptor/build -ErrorAction SilentlyContinue\"",
    "clean:native-host": "powershell -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force src/native-host/build -ErrorAction SilentlyContinue\"",
    "clean:extension": "powershell -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force src/extension/dist -ErrorAction SilentlyContinue\"",
    "install:mapi": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall:mapi": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1 -Uninstall",
    "test:dll:sandbox": "powershell -ExecutionPolicy Bypass -File tests/sandbox/run-sandbox-test.ps1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/go-mapi.git"
  },
  "keywords": [
    "mapi",
    "gmail",
    "windows",
    "email",
    "google-workspace"
  ],
  "author": "",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.0",
    "eslint": "^9.0.0",
    "sharp": "^0.34.5",
    "typescript-eslint": "^8.55.0"
  }
}

{
  "name": "go-mapi",
  "description": "MAPI to Gmail bridge for Windows - send emails via Gmail from any Windows application",
  "private": true,
  "workspaces": [
    "src/app",
    "src/app/frontend"
  ],
  "scripts": {
    "build": "npm run build:interceptor",
    "build:interceptor": "powershell -ExecutionPolicy Bypass -File src/interceptor/build.ps1 -Config Release",
    "build:interceptor:debug": "powershell -ExecutionPolicy Bypass -File src/interceptor/build.ps1 -Config Debug -Tests",
    "test:interceptor": "powershell -ExecutionPolicy Bypass -Command \"src/interceptor/build/bin/go-mapi-test-harness.exe src/interceptor/build/bin/go-mapi.dll\"",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.config.ts",
    "clean": "npm run clean:interceptor",
    "clean:interceptor": "powershell -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force src/interceptor/build -ErrorAction SilentlyContinue\"",
    "install:mapi": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall:mapi": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1 -Uninstall",
    "test:dll:sandbox": "powershell -ExecutionPolicy Bypass -File tests/sandbox/run-sandbox-test.ps1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/go-mapi.git"
  },
  "keywords": [
    "mapi",
    "gmail",
    "windows",
    "email",
    "google-workspace"
  ],
  "author": "",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@playwright/test": "^1.58.0"
  }
}
